# ─────────────────────────────────────────────────────────────
# Слой данных приложения
#
# Приложение обращается к данным только через `api` из src/api.
# Какая реализация подставится — решает VITE_API_MODE и только он.
# Компоненты и хуки при переключении не меняются.
# ─────────────────────────────────────────────────────────────

# mock — данные из src/mocks/tours.json, брони в localStorage.
#        Backend не нужен, приложение полностью работоспособно.
# http — реальные HTTP-запросы на VITE_API_BASE_URL.
VITE_API_MODE=mock

# Требуется только при VITE_API_MODE=http.
# Контракт эндпоинтов описан в ai-rules/frontend.md → Output Contracts → HTTP.
VITE_API_BASE_URL=http://localhost:8080/api

# Искусственная задержка мок-адаптера, мс. Только для режима mock.
# 0 — мгновенный ответ (так гоняются тесты).
VITE_MOCK_LATENCY=300
