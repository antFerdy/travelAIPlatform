# ─────────────────────────────────────────────────────────────
# Слой данных
#
# Приложение обращается к данным только через `api` из src/api.
# Единственная реализация — HTTP-клиент реального бэкенда.
# Контракт ручек: docs/superpowers/specs/api.md
# ─────────────────────────────────────────────────────────────

# Базовый адрес API без /api/v1 — префикс добавляет клиент.
VITE_API_BASE_URL=http://localhost:8080

# Адрес AI-сервиса (ai-service) без /chat — путь добавляет клиент.
# Сервис поднимается отдельно: см. ai-service/README.md.
VITE_AI_API_BASE_URL=http://localhost:8000

# Только для e2e: поднимает MSW в браузере и подменяет бэкенд.
# В обычной сборке ветка вырезается на этапе сборки.
# VITE_ENABLE_MSW=true
